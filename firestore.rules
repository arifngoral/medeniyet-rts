rules_version = '2';
// Firestore security rules of the optional accounts (src/cloud/sync.js). Paste into Firebase console -> Firestore -> Rules.
//   users/{uid}/...   a player's own data (profile meta, TP, saves, match history, friends, chat log): only that player
//   profiles/{uid}    the public card (name, avatar, games, wins): every signed-in player reads, only its owner writes
//   names/{key}       user name claims: every signed-in player reads; created for yourself, changed / freed only by its owner
//   chat/{id}         the world chat (public read; a line is created by its sender only)
//   stats/...         written by the server with a service account (rules do not apply to it); nobody else
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /names/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // the world chat's lasting copy (srv/chat-store.mjs): public to read; a signed-in player adds lines only with their
    // own uid and their profile name; nobody edits or deletes (the owner can, in the console)
    match /chat/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'uid', 'name', 'text'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is int && request.resource.data.t > request.time.toMillis() - 120000 && request.resource.data.t < request.time.toMillis() + 120000
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)/meta/profile).data.name;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
